APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/learnable

DB_HOST=localhost
DB_PORT=3306
DB_NAME=firsthonour_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Random deployment-specific value used only to hash CBT IP/device evidence.
# Generate at least 32 random characters; do not reuse the database password.
CBT_INTEGRITY_SALT=

# Autosave interval for active CBT attempts (milliseconds, minimum 3000).
CBT_AUTOSAVE_INTERVAL=8000
CBT_OPENING_REMINDER_MINUTES=60
CBT_CLOSING_REMINDER_MINUTES=60

# Optional local browser-regression account password. Never set this in production.
E2E_DEMO_PASSWORD=
